# CoRide Beachhead Config — PRD §2
# One high-density corridor for MVP launch. Room only feels alive if density is focused.
# BEACHHEAD_LINE=blue  -> Blue Line only (recommended: Rajiv Chowk ↔ Botanical cluster)
# BEACHHEAD_LINE=yellow -> Yellow Line only (DU ↔ Gurugram campus corridor)
# BEACHHEAD_LINE=all    -> Disable filter (post-MVP multi-city rollout)
BEACHHEAD_LINE=blue
# Optional slice: BEACHHEAD_STATIONS=rajiv_chowk:botanical_garden  (limits corridor segment)
BEACHHEAD_STATIONS=
PORT=4000

# Prod infra (docker-compose) — leave empty for file-based MVP, set for pg/redis
DATABASE_URL=postgres://coride:coride@localhost:5432/coride
REDIS_URL=redis://localhost:6379

# Web Push VAPID (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@coride.app
