# CoRide Beachhead Config — PRD §2
# One high-density corridor for MVP launch. Room only feels alive if density is focused.
# BEACHHEAD_LINE=blue  -> Blue Line only (recommended: Rajiv Chowk ↔ Botanical cluster)
# BEACHHEAD_LINE=yellow -> Yellow Line only (DU ↔ Gurugram campus corridor)
# BEACHHEAD_LINE=all    -> Disable filter (post-MVP multi-city rollout)
BEACHHEAD_LINE=blue
# Optional slice: BEACHHEAD_STATIONS=rajiv_chowk:botanical_garden  (limits corridor segment)
BEACHHEAD_STATIONS=
PORT=4000

# Real data — no mock seeds, no phone. Set REAL_DATA=true for production (only real users in rooms)
REAL_DATA=false
MOCK_SEEDS=true
# Storage. Unset = JSON file store in DATA_DIR (default src/data or dist/data).
# Set DATABASE_URL to keep all state in Postgres (one JSONB snapshot row in
# `app_state`, loaded at boot; the server refuses to start if Postgres is
# unreachable). Both modes are SINGLE-INSTANCE — do not run 2+ API replicas.
# DATABASE_URL=postgres://coride:coride@localhost:5432/coride
# DATA_DIR=/var/lib/coride
REDIS_URL=redis://localhost:6379

# ── Security (required in production) ─────────────────────────────────────
# NODE_ENV=production refuses to boot unless AUTH_SECRET is >= 32 random chars:
#   openssl rand -base64 48
# NODE_ENV=production
AUTH_SECRET=
# Enables moderator routes (/api/admin/*, /api/moderation/reports,
# /api/analytics/summary, /api/push/subscriptions) via the x-admin-token header.
ADMIN_TOKEN=
# Extra browser origins allowed by CORS in production (comma-separated). The
# Capacitor app origins (https://localhost, capacitor://localhost) are always
# allowed. Outside production every origin is allowed. `*` allows all.
CORS_ORIGINS=
# Which proxies to trust for client IPs (rate limiting). Default trusts
# private-network proxies only; e.g. TRUST_PROXY=1 behind exactly one proxy.
TRUST_PROXY=
# 1 = legacy private reads (friends / pending / sent lists, context detect,
# rank/vibe, room list) require a token. Enable once every client build sends
# Authorization on those calls.
STRICT_AUTH=0
# Rate limits (per user, or per IP when signed out)
# RATE_LIMIT_PER_MIN=300
# WRITE_LIMIT_PER_MIN=60
# SOCKET_EVENTS_PER_10S=100

# Web Push VAPID (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@coride.app
