rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && request.resource.data.id == userId;
      allow delete: if isOwner(userId);
    }

    // Metro Station and Train Rooms
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if false; // Room metadata is managed by system / Cloud Functions

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 500;
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // Direct Messages between paired commuters
    match /chats/{chatId} {
      allow read, write: if isAuthenticated() && (request.auth.uid in resource.data.participantIds || request.auth.uid in request.resource.data.participantIds);

      match /messages/{messageId} {
        allow read, write: if isAuthenticated()
                      && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds)
                      && request.resource.data.content is string
                      && request.resource.data.content.size() <= 1000;
      }
    }

    // Connection Requests (Commuter Connect)
    match /connection_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.toUserId == request.auth.uid || resource.data.fromUserId == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
    }

    // Safety Reports & Emergency Alerts
    match /safety_reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.reportedBy == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
